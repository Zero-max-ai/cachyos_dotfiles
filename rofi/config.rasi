configuration {
    modi: "drun,run,window";
    show-icons: true;
    icon-theme: "Papirus";
    terminal: "alacritty";
    drun-display-format: "{name}";
    display-drun: "Apps";
    display-run: "Run";
    display-window: "Windows";
}

* {
    bg:         #1e1e2e;
    surface:    #313244;
    fg:         #cdd6f4;
    muted:      #a6adc8;
    accent:     #89b4fa;

    background-color: transparent;
    text-color: @fg;
    font: "Hack Nerd Font 11";
    border: 0;
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    location: center;
    anchor: center;
    width: 500px;
    background-color: @bg;
    border: 1px;
    border-color: @surface;
}

mainbox {
    padding: 20px;
    spacing: 16px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 0 0 10px 0;
    spacing: 10px;
    border: 0 0 1px 0;
    border-color: @accent;
    children: [ prompt, entry ];
}

prompt {
    text-color: @fg;
}

entry {
    text-color: @fg;
    placeholder: "Search";
    placeholder-color: @muted;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: true;
    scrollbar: false;
    cycle: true;
    dynamic: true;
}

element {
    padding: 8px 10px;
    spacing: 12px;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 24px;
    vertical-align: 0.5;
}

element-text {
    text-color: inherit;
    vertical-align: 0.5;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @surface;
    text-color: @accent;
    border: 0 0 0 2px;
    border-color: @accent;
}
